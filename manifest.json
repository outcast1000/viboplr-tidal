{
  "id": "tidal-browse",
  "name": "TIDAL",
  "version": "1.3.2",
  "author": "Viboplr",
  "description": "Search, stream, and download from TIDAL",
  "icon": "M2 12l5-5 5 5-5 5zM12 12l5-5 5 5-5 5zM7 7l5-5 5 5-5 5z",
  "minAppVersion": "1.0.85",
  "runtime": "worker",
  "permissions": [
    "network:*",
    "system:open",
    "playback:control",
    "library:read"
  ],
  "permissionReasons": {
    "network:*": "Reach TIDAL through community-run API and streaming servers that come and go, so no fixed list of hosts works",
    "system:open": "Open a TIDAL server status page in your browser",
    "playback:control": "Play or enqueue TIDAL tracks, albums and search results",
    "library:read": "Read a playlist's tracks when you choose to download that playlist from TIDAL"
  },
  "autoEnable": false,
  "stability": "experimental",
  "homepage": "https://github.com/outcast1000/viboplr-tidal",
  "updateUrl": "https://github.com/outcast1000/viboplr-tidal/releases/latest/download/update.json",
  "contributes": {
    "imageProviders": [
      {
        "entity": "artist"
      },
      {
        "entity": "album"
      }
    ],
    "sidebarItems": [
      {
        "id": "tidal",
        "label": "TIDAL",
        "icon": "M2 12l5-5 5 5-5 5zM12 12l5-5 5 5-5 5zM7 7l5-5 5 5-5 5z"
      }
    ],
    "contextMenuItems": [
      {
        "id": "search-tidal",
        "label": "Search",
        "targets": [
          "track",
          "album",
          "artist"
        ]
      },
      {
        "id": "play-from-tidal",
        "label": "Play",
        "targets": [
          "track",
          "album"
        ]
      },
      {
        "id": "download-playlist-from-tidal",
        "label": "Download",
        "targets": [
          "playlist"
        ]
      }
    ],
    "downloadProviders": [
      {
        "id": "tidal-download",
        "name": "TIDAL"
      }
    ],
    "streamResolvers": [
      {
        "id": "tidal-fallback",
        "name": "TIDAL"
      }
    ],
    "settingsPanel": {
      "id": "tidal-settings",
      "label": "TIDAL",
      "order": 50
    }
  }
}
